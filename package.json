{
  "name": "dsh-deep-sea",
  "version": "1.0.0",
  "description": "守护光源 · 深海 —— 操控鲸鱼少女在无限下潜的深海里游动，自动向鼠标方向吐光弹；光是命，咬光点/打怪回光。DSH 侧栏原创小游戏。",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "game", "arcade", "underwater"],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-slots"] }
  }
}